{$NEWSLETTER_HOST} {
    encode zstd gzip
    reverse_proxy keila:4000
}
{$STUDIO_HOST} {
    basic_auth {
        {$STUDIO_USER} {$STUDIO_PASSWORD_HASH}
    }
    root * /srv/studio
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control no-store
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-src 'self' blob:; img-src 'self' https: data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
    file_server
}
